<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- záloha se zálohou telefonu (F6-03): jen soubor zálohy, pravidla v res/xml/zaloha_pravidla.xml -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/zaloha_pravidla"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Android 11+ jinak aplikaci Fotoaparát nevidí a místo ní otevře jen galerii (fotka u cviku, F2-05) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <!-- obrázky cviků z free-exercise-db (raw.githubusercontent.com), jinak appka běží offline -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- vibrace na konci pauzy (navigator.vibrate, F1-04) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- konec pauzy (F6-02): oznámení (Android 13+ se na něj ptá) a jeho naplánování na přesný čas;
         přesný čas uživatel povoluje v nastavení systému (Budíky a připomenutí), bez něj se oznámení zpozdí -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
